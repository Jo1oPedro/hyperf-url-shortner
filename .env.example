APP_NAME=skeleton
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

KAFKA_BROKERS=kafka:9092

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRUST_PROXY_HEADERS=true

JWT_ALGORITHM=HS256
JWT_SECRET=dev-secret-change-me-with-32-bytes-minimum
JWT_ISSUER=hyperf-url-shortener
JWT_AUDIENCE=hyperf-url-shortener-api
JWT_TTL_SECONDS=3600